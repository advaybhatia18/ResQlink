# Supabase project settings: Project Settings > API.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-or-service-role-key

# Used only to authorize resolving alerts from the command-centre dashboard.
RESQLINK_ADMIN_TOKEN=replace-this-with-a-long-random-admin-token

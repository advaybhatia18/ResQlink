# Supabase project settings: Project Settings > API.
SUPABASE_URL=<SUPABASE_URL>
SUPABASE_KEY=<SUPABASE_ANON_KEY>
SUPABASE_SERVICE_ROLE_KEY=<SUPABASE_SERVICE_ROLE_KEY>

# Comma-separated web origins allowed to call the API (scheme+host+port only, no path or trailing slash).
FRONTEND_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,https://advaybhatia18.github.io,https://aksh.is-a.dev

# Must be added to Supabase Auth's allowed redirect URLs.
PASSWORD_RESET_REDIRECT_URL=http://127.0.0.1:5500/password-reset.html

# Optional overrides (leave unset for defaults)
# RESQLINK_ENGINE_PATH=
# RESQLINK_NOTIFICATION_WEBHOOK_URL=
